{
  "schemaVersion": 1,
  "id": "fairutils",
  "version": "${version}",
  "name": "Fair Utils",
  "description": "Fair client-sided player utilities such as Damage Indicators and stuff.",
  "authors": [],
  "contact": {},
  "license": "CC BY NC-SA 4.0",
  "icon": "assets/fairutils/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.ctrlneo.fairutils.client.FairUtilsClient"
    ],
    "main": [
      "dev.ctrlneo.fairutils.FairUtils"
    ],
    "modmenu": [
      "dev.ctrlneo.fairutils.client.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "fairutils.mixins.json",
    {
      "config": "fairutils.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "yet_another_config_lib_v3": ">=3.6.6+1.21.5-fabric"
  },
  "custom": {
    "modmenu": {
      "links": {
        "Source": "https://github.com/CTRL-Neo-Studios/fair-utils"
      },
      "badges": [ "client" ]
    }
  }
}
